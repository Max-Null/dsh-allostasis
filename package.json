{
  "name": "@max-null/dsh-allostasis",
  "version": "0.5.4",
  "description": "应变（allostasis）：模型复读、推理退化、思考死循环的检测与掐断——语言漂移锚定、退化提醒、空回合兜底，以及生成中截断复读并续跑",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "docs/shots"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "allostasis",
    "应变",
    "self-regulation",
    "plugin",
    "cordis",
    "复读",
    "重复",
    "推理退化",
    "退化",
    "死循环",
    "思考循环",
    "卡住",
    "停不下来",
    "掐断",
    "思维链",
    "repetition",
    "degeneration",
    "thinking-loop",
    "reasoning-loop",
    "stuck",
    "loop-guard",
    "context",
    "中文"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max-Null/dsh-allostasis.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.1 <0.3.0",
    "@deepseek-ai/dsh-compaction": ">=0.1.7-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-token-meter": "^0.1.7-rc.2",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
