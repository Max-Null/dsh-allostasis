{
  // typecheck 配置：paths 指向相邻 DSH checkout 的构建产物（lib/types/*.d.ts），
  // 只检查 dsh-allostasis 自己的代码；DSH 源码的检查由 DSH 自己的 CI 负责。
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "test"]
}

